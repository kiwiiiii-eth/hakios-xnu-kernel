# (2026-11-24) The home screen's names after a system image with new file times (build.sh SYSTEM_TIME): lsplugins --apps
# registers the system applications again, then SpringBoard is started again; for the screen recording (rec_ring=1):
# the lock screen swiped away, the home screen, Settings.
/redwood/bin/quietboot &
/var/jb/usr/bin/sleep 30
/redwood/bin/lsplugins --apps
/var/jb/usr/bin/killall -9 SpringBoard
/redwood/bin/rwtouch wait 25 swipe 0.5 0.985 0.5 0.3 250
/var/jb/usr/bin/sleep 12
/redwood/bin/rwtouch notify com.hakios.open.prefs
/var/jb/usr/bin/sleep 36000
