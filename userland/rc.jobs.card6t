# (2026-11-23) The AirPods' card empty again (r264): in r257 its 12 MB (SharingDeviceAssets) came in and the card showed
# Connect; in r263, paired again, it was empty. Seen here: the assets on the data volume, and what mobileassetd and
# SharingViewService said in r263 (17:00 on).
/var/jb/usr/bin/sleep 20
/var/jb/usr/bin/find /private/var/MobileAsset/AssetsV2/com_apple_MobileAsset_SharingDeviceAssets -maxdepth 3
/redwood/bin/logdump 2400 process=="mobileassetd" >> /private/var/root/card-mad3.txt
/var/jb/usr/bin/grep -m 60 -aE -e ^17:.*(SharingViewService|SharingDeviceAssets.e5|MADownload|purge|Purge|garbage|delete|Removing) /private/var/root/card-mad3.txt
/redwood/bin/logdump 2400 process=="SharingViewService" >> /private/var/root/card-svs3.txt
/var/jb/usr/bin/grep -m 60 -aE -e ^17:.*(Headphone|ProductKit|asset|Asset|movie) /private/var/root/card-svs3.txt
/var/jb/usr/bin/grep -m 40 -aE -e ^16:(1[0-9]|2[0-2]).*(Headphone|ProductKit:Requests|movie) /private/var/root/card-svs3.txt
/var/jb/usr/bin/sleep 36000
