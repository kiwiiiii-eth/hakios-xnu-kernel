# The hotspot as a person turns it on (25 November): off at the start, then Settings > Personal Hotspot > Allow Others to
# Join tapped; the ESP32 hotspot client (tools-local/esp32-hotspot-client) joins, checks and leaves meanwhile.
/redwood/bin/quietboot &
/redwood/bin/rtcclock &
/redwood/bin/celltz &
/redwood/bin/gnssfeed &
/redwood/bin/lsplugins
/redwood/bin/hotspot status
/redwood/bin/cellnet_test 110
# on in Settings > Personal Hotspot (rc.jobs.hotui6t.sh), the ESP32 at it for 200 s, then off the same way
/var/jb/bin/sh /redwood/etc/rc.jobs.sh ON
/var/jb/usr/bin/sleep 200
/redwood/bin/hotspot status
/redwood/bin/cellnet_test
/var/jb/bin/sh /redwood/etc/rc.jobs.sh off
/var/jb/usr/bin/sleep 36000
