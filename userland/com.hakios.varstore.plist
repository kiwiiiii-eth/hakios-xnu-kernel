<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.hakios.varstore</string>
	<!-- with var_store=1 among the kernel's arguments: stays for the run and writes /private/var into
	     the flash when the kernel says the run is ending, and when the system goes down (launchd's
	     SIGTERM: Shut Down, Restart) -- src/varsaver.c, which has var_store save do the writing; without,
	     it ends at once. An argument is seconds between saves of its own accord as well; there is none
	     by default, because each one costs seconds of the run and a hundred-odd megabytes. -->
	<key>ProgramArguments</key>
	<array>
		<string>/redwood/bin/varsaver</string>
	</array>
	<!-- a save takes 50-60 s on the 6T: launchd waits this long after SIGTERM before it kills -->
	<key>ExitTimeOut</key>
	<integer>240</integer>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/dev/console</string>
	<key>StandardErrorPath</key>
	<string>/dev/console</string>
</dict>
</plist>
