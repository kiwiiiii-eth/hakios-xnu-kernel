# (2026-11-24) Settings and the home screen seen without a hand on the phone, in the screen recording (boot-args
# rec_start=40 rec_secs=110 rec_step=3): the applications registered again (lsplugins --apps: their Chinese names), the
# lock screen swiped away, the home screen, Settings (com.hakios.open.prefs), its Personal Hotspot row tapped, home again,
# the volume HUD (down, then up again).
/redwood/bin/quietboot &
/var/jb/usr/bin/sleep 30
/redwood/bin/lsplugins --apps
/redwood/bin/rwtouch wait 15 swipe 0.5 0.985 0.5 0.3 250
/var/jb/usr/bin/sleep 8
/redwood/bin/rwtouch notify com.hakios.open.prefs
/var/jb/usr/bin/sleep 8
/redwood/bin/rwtouch tap 0.5 0.538
/var/jb/usr/bin/sleep 6
/redwood/bin/rwtouch swipe 0.5 0.995 0.5 0.6 200
/var/jb/usr/bin/sleep 5
/redwood/bin/rwtouch button voldown 120
/var/jb/usr/bin/sleep 3
/redwood/bin/rwtouch button volup 120
/var/jb/usr/bin/sleep 36000
