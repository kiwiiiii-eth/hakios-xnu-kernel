# (2026-11-25) Screenshots of Settings with the native cellular data (as rc.jobs.cell6t; boot-args rec_ring=1 rec_mb=256
# rec_start=60 rec_secs=150 rec_step=4): Cellular, then its Personal Hotspot row (ours since 25 November), then the
# main list's; the hotspot meanwhile, for a station to join.
/redwood/bin/quietboot &
/redwood/bin/rtcclock &
/redwood/bin/celltz &
/redwood/bin/gnssfeed &
/redwood/bin/lsplugins
/redwood/bin/cellnet_test 130
/redwood/bin/rwtouch notify com.hakios.unlock wait 3 notify com.hakios.open.prefs wait 8
/redwood/bin/battery_test open prefs:root=MOBILE_DATA_SETTINGS_ID
/redwood/bin/rwtouch wait 8 tap 0.5 0.286 wait 10
/redwood/bin/battery_test open prefs:root=INTERNET_TETHERING
/var/jb/usr/bin/sleep 12
/redwood/bin/cellnet_test
/var/jb/usr/bin/sleep 36000
