# drivers/modem/conf: QMI, and the cellular modem.
# CONFIG_HAKIOS_<NAME>=y in a defconfig builds a driver into the kernel; "standard" files are always built.
# tools/hakios-config.py reads this file; docs/drivers-config.md says what each word means and how it reaches XNU.

driver QMI
	file    bsd/dev/hakios.qmi.c
	help    QMI messages over the IPC router: how the Wi-Fi firmware's service and the modem's are spoken to

driver CELL
	file    bsd/dev/hakios.cell.c
	file    bsd/dev/hakios.nas.c
	file    bsd/dev/hakios.ipa.c
	requires QMI
	help    what both modems' drivers use: the IPA's data path as en1, the network registration (NAS)

driver MODEM
	file    bsd/dev/hakios.mpss.c
	requires QMI UFS CELL
	help    the modem (modem=1): started, its file systems served from the flash, the IPA's data path as en1,
	help    the SIM and the network registration. Research; needs fw-modem/ from the phone

driver MPSS845
	file    bsd/dev/hakios.mpss845.c
	requires QMI UFS CELL
	default n
	help    the SDM845's modem (OnePlus 6T), the reference phone's driver copied and made the 6T's (modem_step=N); for the
	help    Wi-Fi, whose firmware runs on it. Research; needs fw-modem/ from the phone

driver BASEBAND
	file    iokit/Kernel/hakios.baseband.cpp iokitcpp
	file    bsd/dev/hakios.qmux.c
	default n
	help    Apple's baseband drivers as Darwin's telephony looks them up (AppleBaseband, AppleIPAppender), stand-ins that
	help    answer every call and say what it was (abb=1, a test): CommCenter's way to the modem
